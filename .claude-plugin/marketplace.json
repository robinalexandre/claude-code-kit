{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "claude-code-kit",
  "description": "Skills, mods, hooks, a status line and a config sync for Claude Code that work on macOS, Linux and Windows. Every part of the kit is a plugin; the parts that need a few answers ask for them at the first session.",
  "owner": {
    "name": "robinalexandre",
    "url": "https://github.com/robinalexandre/claude-code-kit"
  },
  "plugins": [
    {
      "name": "team",
      "description": "Base rules: Claude works as a teammate, challenges you, and asks before production, commits, pushes, PRs and decisions that need your context.",
      "version": "1.0.1",
      "category": "productivity",
      "source": ".",
      "strict": false,
      "skills": [
        "./hooks"
      ],
      "userConfig": {
        "language": {
          "type": "string",
          "title": "Language",
          "description": "The language Claude talks to you in by default (e.g. English, Français, Español).",
          "default": "English"
        }
      },
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/team-rules.sh\" 2>/dev/null || true",
                "timeout": 15
              }
            ]
          }
        ]
      }
    },
    {
      "name": "statusline",
      "description": "A status line with folder, branch, model, context used, effort and rate limit, and a sign when the config sync is paused (asks once to set it in your settings).",
      "version": "1.4.2",
      "category": "productivity",
      "source": ".",
      "strict": false,
      "skills": [
        "./hooks"
      ],
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kit-session.sh\" statusline 2>/dev/null || true",
                "timeout": 15
              }
            ]
          }
        ]
      }
    },
    {
      "name": "file-tools-guard",
      "description": "Blocks shell workarounds (cat, sed -i, heredocs) for reading and editing files, so Claude uses its own file tools.",
      "version": "1.0.1",
      "category": "productivity",
      "source": ".",
      "strict": false,
      "skills": [
        "./hooks"
      ],
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "Bash",
            "hooks": [
              {
                "type": "command",
                "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/file-tools-guard.sh\" 2>/dev/null || true",
                "timeout": 5
              }
            ]
          }
        ]
      }
    },
    {
      "name": "recent-prompts",
      "description": "Your last two messages above the prompt, and a searchable history pane (/prompts).",
      "category": "productivity",
      "source": "./mods/recent-prompts"
    },
    {
      "name": "configuration",
      "description": "The Configuration pane of the kit's panes (a button on the band, /configuration): every mod's settings, for all computers or this one. The pane mods bring it with them.",
      "category": "productivity",
      "source": "./mods/configuration"
    },
    {
      "name": "dnd",
      "description": "Do not disturb for the history, dev activity and reminders-handoffs panes: profiles that hide a pane or keep only some repos and groups, on by hand (/dnd) or by Wi-Fi, days and hours, or folder.",
      "category": "productivity",
      "source": "./mods/dnd",
      "skills": [
        "./skills/dnd"
      ]
    },
    {
      "name": "paste-preview",
      "description": "Pasted text shown in full, and previews of pasted images (macOS, Windows).",
      "category": "productivity",
      "source": "./mods/paste-preview"
    },
    {
      "name": "recent-activity",
      "description": "A digest of your recent sessions across your dev folder at each session start, so Claude knows what you did lately in your other repos.",
      "version": "1.1.4",
      "category": "productivity",
      "source": ".",
      "strict": false,
      "skills": [
        "./hooks"
      ],
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/recent-activity.sh\" digest 2>/dev/null || true",
                "timeout": 15
              },
              {
                "type": "command",
                "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kit-session.sh\" recent-activity 2>/dev/null || true",
                "timeout": 15
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/recent-activity.sh\" record 2>/dev/null || true",
                "timeout": 5
              }
            ]
          }
        ]
      }
    },
    {
      "name": "tab-status",
      "description": "Shows each session's state in its terminal tab (🟡 working, 🔴 waiting for you, 🟢 done, ❌ failed) with its repo and title, and rings the bell when it needs you.",
      "version": "1.0.1",
      "category": "productivity",
      "source": ".",
      "strict": false,
      "skills": [
        "./hooks"
      ],
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/tab-status.sh\" start 2>/dev/null || true",
                "timeout": 10,
                "async": true
              },
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/tab-status.sh\" check 2>/dev/null || true",
                "timeout": 5
              }
            ]
          }
        ],
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/tab-status.sh\" working 2>/dev/null || true",
                "timeout": 10,
                "async": true
              }
            ]
          }
        ],
        "PreToolUse": [
          {
            "matcher": "AskUserQuestion",
            "hooks": [
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/tab-status.sh\" waiting 2>/dev/null || true",
                "timeout": 5
              }
            ]
          }
        ],
        "PermissionRequest": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/tab-status.sh\" waiting 2>/dev/null || true",
                "timeout": 5
              }
            ]
          }
        ],
        "Notification": [
          {
            "matcher": "elicitation_dialog",
            "hooks": [
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/tab-status.sh\" waiting 2>/dev/null || true",
                "timeout": 5
              }
            ]
          }
        ],
        "PostToolUse": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/tab-status.sh\" working 2>/dev/null || true",
                "timeout": 10,
                "async": true
              }
            ]
          }
        ],
        "PermissionDenied": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/tab-status.sh\" working 2>/dev/null || true",
                "timeout": 10,
                "async": true
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/tab-status.sh\" done 2>/dev/null || true",
                "timeout": 5
              }
            ]
          }
        ],
        "StopFailure": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/tab-status.sh\" error 2>/dev/null || true",
                "timeout": 5
              }
            ]
          }
        ],
        "SessionEnd": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/tab-status.sh\" end 2>/dev/null || true",
                "timeout": 5
              }
            ]
          }
        ]
      }
    },
    {
      "name": "reopen-sessions",
      "description": "Reopens in new terminal tabs the sessions that were running before a crash, or those about a topic you name, in whatever terminal or app you use.",
      "version": "1.1.0",
      "category": "productivity",
      "source": ".",
      "strict": false,
      "skills": [
        "./skills/reopen-sessions"
      ]
    },
    {
      "name": "session-registry",
      "description": "Offers to resume the sessions left open in a terminal tab, by title and brief, with a checkbox picker (zsh, JetBrains or Ghostty terminals).",
      "version": "1.2.3",
      "category": "productivity",
      "source": ".",
      "strict": false,
      "skills": [
        "./hooks"
      ],
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-registry.sh\" start 2>/dev/null || true",
                "timeout": 15
              },
              {
                "type": "command",
                "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kit-session.sh\" session-registry 2>/dev/null || true",
                "timeout": 15
              }
            ]
          }
        ],
        "SessionEnd": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-registry.sh\" end 2>/dev/null || true",
                "timeout": 5
              }
            ]
          }
        ]
      }
    },
    {
      "name": "drift-check",
      "description": "When a reply doesn't start with your opening text (an emoji, a word or a name), asks Claude to check it against your CLAUDE.md and fix what slipped.",
      "category": "productivity",
      "source": "./mods/drift-check"
    },
    {
      "name": "drift-check-hook",
      "description": "A warning whenever a reply doesn't start with your opening text (the hook form of drift-check, for setups without mods).",
      "version": "1.2.0",
      "category": "productivity",
      "source": ".",
      "strict": false,
      "skills": [
        "./hooks"
      ],
      "userConfig": {
        "marker": {
          "type": "string",
          "title": "Opening text",
          "description": "What every reply must start with: an emoji, a word or a name (e.g. 🌊). Your CLAUDE.md needs the rule \"Start every message with <it>\". Empty: the drift-check mod's setting is used, else CLAUDE_REPLY_MARKER in settings.json env.",
          "default": ""
        }
      },
      "hooks": {
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/drift-check.sh\" prompt 2>/dev/null || true",
                "timeout": 5
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/drift-check.sh\" stop 2>/dev/null || true",
                "timeout": 5
              }
            ]
          }
        ]
      }
    },
    {
      "name": "nocturne-notify",
      "description": "Keyboard-backlight signals of Claude's state through Agent Nocturne (github.com/taekchef/agent-nocturne).",
      "version": "1.0.0",
      "category": "productivity",
      "source": ".",
      "strict": false,
      "skills": [
        "./hooks"
      ],
      "hooks": {
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/nocturne-notify.sh\" idle",
                "timeout": 5
              }
            ]
          }
        ],
        "PreToolUse": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/nocturne-notify.sh\" idle",
                "timeout": 5
              }
            ]
          }
        ],
        "PostToolUse": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/nocturne-notify.sh\" idle",
                "timeout": 5
              }
            ]
          }
        ],
        "PermissionRequest": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/nocturne-notify.sh\" permission --ttl 180000",
                "timeout": 5
              }
            ]
          }
        ],
        "Notification": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/nocturne-notify.sh\" permission --ttl 180000",
                "timeout": 5
              }
            ]
          }
        ],
        "PermissionDenied": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/nocturne-notify.sh\" blocked",
                "timeout": 5
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/nocturne-notify.sh\" done",
                "timeout": 5
              }
            ]
          }
        ],
        "StopFailure": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/nocturne-notify.sh\" error --terminal",
                "timeout": 5
              }
            ]
          }
        ],
        "SessionEnd": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/nocturne-notify.sh\" idle",
                "timeout": 5
              }
            ]
          }
        ]
      }
    },
    {
