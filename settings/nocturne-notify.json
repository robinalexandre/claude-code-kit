{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"__HOME__/.claude/hooks/nocturne-notify.sh\" idle",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"__HOME__/.claude/hooks/nocturne-notify.sh\" idle",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"__HOME__/.claude/hooks/nocturne-notify.sh\" idle",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"__HOME__/.claude/hooks/nocturne-notify.sh\" permission --ttl 180000",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"__HOME__/.claude/hooks/nocturne-notify.sh\" permission --ttl 180000",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"__HOME__/.claude/hooks/nocturne-notify.sh\" blocked",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"__HOME__/.claude/hooks/nocturne-notify.sh\" done",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"__HOME__/.claude/hooks/nocturne-notify.sh\" error --terminal",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"__HOME__/.claude/hooks/nocturne-notify.sh\" idle",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
