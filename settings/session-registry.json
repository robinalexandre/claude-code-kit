{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__HOME__/.claude/hooks/session-registry.sh\" start 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__HOME__/.claude/hooks/session-registry.sh\" end 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
