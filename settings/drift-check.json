{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__HOME__/.claude/hooks/drift-check.sh\" prompt 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__HOME__/.claude/hooks/drift-check.sh\" stop 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
