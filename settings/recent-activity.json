{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__HOME__/.claude/hooks/recent-activity.sh\" digest 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__HOME__/.claude/hooks/recent-activity.sh\" record 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
