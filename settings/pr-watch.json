{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__HOME__/.claude/skills/pr-watch/session.sh\" start 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__HOME__/.claude/skills/pr-watch/session.sh\" prompt 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
